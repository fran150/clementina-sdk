{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clementina.dev/schema/instrument.schema.json",
  "title": "Clementina instrument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "wave",
    "pulse",
    "attack",
    "decay",
    "sustain",
    "release",
    "volume"
  ],
  "properties": {
    "format": {
      "const": "clementina-instrument"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
    },
    "wave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "pulse": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "attack": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "decay": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "sustain": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "release": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    }
  }
}
