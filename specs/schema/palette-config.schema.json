{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clementina.dev/schema/palette-config.schema.json",
  "title": "Clementina palette-bank configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "banks"
  ],
  "properties": {
    "format": {
      "const": "clementina-palette-config"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "banks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
