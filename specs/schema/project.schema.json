{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clementina.dev/schema/project.schema.json",
  "title": "Clementina project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "target",
    "program",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "clementina-project"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine"
      ],
      "properties": {
        "machine": {
          "const": "clementina-6502"
        },
        "phi2Hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000000
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "basic",
            "assembly",
            "mixed"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palettes",
        "paletteConfigs",
        "tilesets",
        "shapes",
        "animations"
      ],
      "properties": {
        "palettes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paletteConfigs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tilesets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "animations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputDirectory", "assembly"],
      "properties": {
        "outputDirectory": {"type": "string", "minLength": 1},
        "assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkerConfig", "outputName", "loadAddress", "entrySymbol"],
          "properties": {
            "linkerConfig": {"type": "string", "minLength": 1},
            "outputName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$"},
            "loadAddress": {"type": "integer", "minimum": 1, "maximum": 49151},
            "bank": {"type": "integer", "minimum": 1, "maximum": 31},
            "entrySymbol": {"type": "string", "pattern": "^[A-Za-z_@][A-Za-z0-9_@.$]*$"},
            "includeDirectories": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "defines": {
              "type": "object",
              "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "additionalProperties": {
                "anyOf": [
                  {"type": "string", "pattern": "^[A-Za-z0-9_.$+-]+$"},
                  {"type": "integer"}
                ]
              }
            }
          }
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paletteConfigId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
            "tilesets": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tilesetId", "bank"],
                "properties": {
                  "tilesetId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
                  "bank": {"type": "integer", "minimum": 0, "maximum": 7}
                }
              }
            }
          }
        }
      }
    }
  }
}
