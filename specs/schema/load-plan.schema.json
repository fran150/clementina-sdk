{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clementina.dev/schema/load-plan.schema.json",
  "title": "Clementina runtime load plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "steps"],
  "properties": {
    "format": {"const": "clementina-load-plan"},
    "version": {"const": 1},
    "acknowledgedIssues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["audio-sequencer-sd-memory-overlap"]}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6399,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "address", "length"],
            "properties": {
              "kind": {"const": "mia"},
              "path": {"type": "string", "minLength": 1, "maxLength": 255},
              "address": {"type": "integer", "minimum": 0, "maximum": 262143},
              "length": {"type": "integer", "minimum": 1, "maximum": 262144}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "loadAddress", "length"],
            "properties": {
              "kind": {"const": "prg"},
              "path": {"type": "string", "minLength": 1, "maxLength": 255},
              "loadAddress": {"type": "integer", "minimum": 1, "maximum": 49151},
              "length": {"type": "integer", "minimum": 1, "maximum": 524288},
              "bank": {"type": "integer", "minimum": 1, "maximum": 31},
              "runAddress": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        ]
      }
    }
  }
}
