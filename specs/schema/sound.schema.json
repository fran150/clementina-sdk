{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clementina.dev/schema/sound.schema.json",
  "title": "Clementina sound effect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "attack",
    "decay",
    "sustain",
    "release",
    "pan",
    "frames"
  ],
  "properties": {
    "format": {
      "const": "clementina-sound"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"
    },
    "attack": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "decay": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "sustain": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "release": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "pan": {
      "type": "integer",
      "minimum": -64,
      "maximum": 63
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "freq",
          "volume",
          "pulse",
          "wave",
          "gate"
        ],
        "properties": {
          "freq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "pulse": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "wave": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "gate": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
