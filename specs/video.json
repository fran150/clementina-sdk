{
  "format": "clementina-video",
  "version": 1,
  "display": {
    "width": 320,
    "height": 200,
    "tileWidth": 8,
    "tileHeight": 8,
    "columns": 40,
    "rows": 25
  },
  "pages": {
    "size": 32,
    "count": 2155,
    "syncable": 2154
  },
  "regions": [
    {
      "name": "LOCAL_CONTROL",
      "start": 0,
      "size": 32,
      "syncable": false,
      "description": "MIA and 6502 local control, counters and diagnostics; never sent to the client."
    },
    {
      "name": "RENDER_CONTROL",
      "start": 32,
      "size": 32,
      "syncable": true,
      "description": "Mode, scroll, layer enables, active banks and CHR decode controls."
    },
    {
      "name": "CONTROL_RESERVED",
      "start": 64,
      "size": 192,
      "syncable": true,
      "description": "Reserved; sent as zero in a full refresh."
    },
    {
      "name": "PALETTE",
      "start": 256,
      "size": 256,
      "syncable": true,
      "description": "16 palette banks of 8 RGB565 colors."
    },
    {
      "name": "CHR",
      "start": 512,
      "size": 49152,
      "syncable": true,
      "description": "8 CHR banks of 256 tiles, 24 bytes per tile (three 2048-byte planes)."
    },
    {
      "name": "BG_NT",
      "start": 49664,
      "size": 8000,
      "syncable": true,
      "description": "8 background nametables of 40x25 tile codes."
    },
    {
      "name": "BG_ATTR",
      "start": 57664,
      "size": 8000,
      "syncable": true,
      "description": "8 background attribute tables of 40x25 bytes."
    },
    {
      "name": "OV_NT",
      "start": 65664,
      "size": 1000,
      "syncable": true,
      "description": "Overlay nametable: 40x25 tile codes, fixed to the screen."
    },
    {
      "name": "OV_ATTR",
      "start": 66664,
      "size": 1000,
      "syncable": true,
      "description": "Overlay attributes: 40x25 bytes."
    },
    {
      "name": "OAM",
      "start": 67664,
      "size": 1280,
      "syncable": true,
      "description": "256 sprite records of 5 bytes."
    }
  ],
  "renderControl": {
    "source": "clementina-mia docs/video-output.md, Render Control Page. The video client renders from this page; MIA only stores it.",
    "fields": [
      {
        "name": "VIDEO_MODE",
        "address": 32,
        "size": 1,
        "description": "Video enable and renderer mode bits (MIA_VIDEO_MODE_*)."
      },
      {
        "name": "LAYER_ENABLE",
        "address": 33,
        "size": 1,
        "description": "Background, overlay and sprite enables (MIA_VIDEO_LAYER_*)."
      },
      {
        "name": "BG_VIEWPORT_MODE",
        "address": 34,
        "size": 1,
        "description": "Viewport mapping within the active background set, 0-5."
      },
      {
        "name": "BG_ACTIVE_SET",
        "address": 35,
        "size": 1,
        "description": "Background table set, 0 or 1."
      },
      {
        "name": "SCROLL_X",
        "address": 36,
        "size": 2,
        "description": "Viewport X position in the active background plane, pixels, little-endian."
      },
      {
        "name": "SCROLL_Y",
        "address": 38,
        "size": 2,
        "description": "Viewport Y position in the active background plane, pixels, little-endian."
      },
      {
        "name": "BG_CHR_BANK",
        "address": 40,
        "size": 1,
        "description": "Primary background CHR bank, 0-7."
      },
      {
        "name": "BG_ALT_CHR_BANK",
        "address": 41,
        "size": 1,
        "description": "Alternate background CHR bank, 0-7, for cells with CHR_ALT set."
      },
      {
        "name": "OVERLAY_CHR_BANK",
        "address": 42,
        "size": 1,
        "description": "Primary overlay CHR bank, 0-7."
      },
      {
        "name": "OVERLAY_ALT_CHR_BANK",
        "address": 43,
        "size": 1,
        "description": "Alternate overlay CHR bank, 0-7, for cells with CHR_ALT set."
      },
      {
        "name": "SPRITE_CHR_BANK",
        "address": 44,
        "size": 1,
        "description": "Sprite CHR bank, 0-7."
      },
      {
        "name": "CHR_1BPP_MASK",
        "address": 45,
        "size": 1,
        "description": "Bit n set decodes CHR bank n as 1bpp instead of 3bpp."
      },
      {
        "name": "CHR_1BPP_PLANES",
        "address": 46,
        "size": 1,
        "description": "1bpp plane selectors, 0-2 each: background bits 0-1, sprites bits 2-3, overlay bits 4-5."
      },
      {
        "name": "BACKDROP_COLOR",
        "address": 47,
        "size": 1,
        "description": "Backdrop color: color index in bits 0-2, palette bank in bits 3-6."
      },
      {
        "name": "OAM_LAST_INDEX",
        "address": 48,
        "size": 1,
        "description": "Last OAM record the renderer evaluates while sprites are enabled."
      }
    ],
    "modeBits": [
      {
        "bit": 0,
        "name": "ENABLE",
        "description": "Video service enabled."
      }
    ],
    "layerBits": [
      {
        "bit": 0,
        "name": "BACKGROUND",
        "description": "Background layer enabled."
      },
      {
        "bit": 1,
        "name": "OVERLAY",
        "description": "Overlay layer enabled."
      },
      {
        "bit": 2,
        "name": "SPRITES",
        "description": "Sprite layer enabled."
      }
    ]
  },
