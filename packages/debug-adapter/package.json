{
  "name": "@clementina/debug-adapter",
  "version": "0.2.0",
  "repository": {"type": "git", "url": "git+https://github.com/fran150/clementina-sdk.git", "directory": "packages/debug-adapter"},
  "engines": {"node": ">=20"},
  "license": "GPL-3.0-only",
  "publishConfig": {"access": "public"},
  "type": "module",
  "main": "./dist/adapter.js",
  "types": "./dist/adapter.d.ts",
  "exports": {
    ".": {"types": "./dist/adapter.d.ts", "import": "./dist/adapter.js"},
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "bin": {
    "clementina-debug-adapter": "./bin/clementina-debug-adapter.mjs"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "bin"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vscode/debugadapter-testsupport": "^1.65.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@clementina/core": "0.2.0",
    "@clementina/debug": "0.2.0",
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0"
  }
