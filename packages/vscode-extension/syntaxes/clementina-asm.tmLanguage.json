{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Clementina Assembly",
  "scopeName": "source.clementina-asm",
  "comment": "Generated by scripts/generate-asm-grammar.mjs from packages/lib/asm/*.inc. Do not edit.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#label-definition"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#clementina"
    },
    {
      "include": "#number"
    },
    {
      "include": "#label-reference"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.clementina-asm",
      "match": ";.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.clementina-asm",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.clementina-asm",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.clementina-asm",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "label-definition": {
      "patterns": [
        {
          "match": "^\\s*(@?[A-Za-z_][A-Za-z0-9_]*)(:{1,2})",
          "captures": {
            "1": {
              "name": "entity.name.label.clementina-asm"
            },
            "2": {
              "name": "punctuation.separator.label.clementina-asm"
            }
          }
        },
        {
          "match": "^\\s*(:)(?=\\s|;|$)",
          "captures": {
            "1": {
              "name": "entity.name.label.unnamed.clementina-asm"
            }
          }
        }
      ]
    },
    "definition": {
      "patterns": [
        {
          "match": "(?i)(\\.(?:macro|mac))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.clementina-asm"
            },
            "2": {
              "name": "entity.name.function.macro.clementina-asm"
            }
          }
        },
        {
          "match": "(?i)(\\.proc)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.clementina-asm"
            },
            "2": {
              "name": "entity.name.function.clementina-asm"
            }
          }
        },
        {
          "match": "(?i)(\\.(?:scope|struct|union|enum))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.clementina-asm"
            },
            "2": {
              "name": "entity.name.type.clementina-asm"
            }
          }
        },
        {
          "match": "(?i)(\\.define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.clementina-asm"
            },
            "2": {
              "name": "entity.name.constant.clementina-asm"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:?=)",
          "captures": {
            "1": {
              "name": "entity.name.constant.clementina-asm"
            },
            "2": {
              "name": "keyword.operator.assignment.clementina-asm"
            }
          }
        }
      ]
    },
    "directive": {
      "name": "keyword.control.directive.clementina-asm",
      "match": "(?<![\\w@])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "instruction": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w@.])(asl|lsr|rol|ror|inc|dec)\\s+(a)(?=\\s*(?:;|$))",
          "captures": {
            "1": {
              "name": "keyword.mnemonic.clementina-asm"
            },
            "2": {
              "name": "variable.language.register.clementina-asm"
            }
          }
        },
        {
          "name": "keyword.mnemonic.clementina-asm",
          "match": "(?i)(?<![\\w@.])(?:adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stp|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya|wai|bbr[0-7]|bbs[0-7]|rmb[0-7]|smb[0-7])(?![\\w@])"
        },
        {
          "match": "(?i),\\s*([xy])(?![\\w@])",
          "captures": {
            "1": {
              "name": "variable.language.register.clementina-asm"
            }
          }
        }
      ]
    },
    "clementina": {
      "patterns": [
        {
          "name": "support.function.macro.clementina-asm",
          "match": "(?<![\\w@.])(?:DrawColumn|DrawRect|DrawRow|DrawScreen|DrawShape|FillPlaceholder|Forget|ForgetShape|GetCell|HideSprites|KeyHeld|LibRestore|LibSave|Load|LoadAnimation|LoadAnimationShapes|LoadBusy|LoadColumns|LoadPart|LoadRect|LoadRows|LoadShape|LoadSprites|LoadStart|LoadWait|MoveAnimation|PlaySong|PlaySound|ReadPad|Relocate|SetCell|SetChrBanks|SetLayers|SetScroll|SetSpriteCount|SetViewport|ShowOverlay|SongPosition|StartAnimation|StopAnimation|StopSong|StopSound|TickAnimation|TickSound|UsePaletteBank|UsePalettes|UseTileset|WaitTick)(?![\\w@])"
        },
        {
          "name": "support.function.routine.clementina-asm",
          "match": "(?<![\\w@.])(?:cl_draw_column|cl_draw_rect|cl_draw_row|cl_draw_screen|cl_draw_shape|cl_fill_placeholder|cl_forget|cl_forget_shape|cl_get_cell|cl_hide_sprites|cl_key_held|cl_load|cl_load_animation|cl_load_animation_at|cl_load_animation_shapes|cl_load_at|cl_load_busy|cl_load_columns|cl_load_columns_at|cl_load_part|cl_load_rect|cl_load_rect_at|cl_load_rows|cl_load_rows_at|cl_load_shape|cl_load_shape_at|cl_load_start|cl_load_start_at|cl_load_wait|cl_move_animation|cl_play_song|cl_play_sound|cl_read_pad|cl_relocate|cl_set_cell|cl_set_chr_banks|cl_set_layers|cl_set_scroll|cl_set_sprite_count|cl_set_viewport|cl_show_overlay|cl_song_position|cl_start_animation|cl_stop_animation|cl_stop_song|cl_stop_sound|cl_tick_animation|cl_tick_sound|cl_use_palette_bank|cl_use_palettes|cl_use_tileset|cl_wait_tick)(?![\\w@])"
        },
        {
          "name": "support.variable.zeropage.clementina-asm",
          "match": "(?<![\\w@.])(?:cl_a0|cl_a1|cl_a10|cl_a11|cl_a2|cl_a3|cl_a4|cl_a5|cl_a6|cl_a7|cl_a8|cl_a9|cl_error|cl_state)(?![\\w@])"
        },
        {
          "name": "support.constant.clementina-asm",
          "match": "(?<![\\w@.])(?:BAS_CHKCOM|BAS_ERROR|BAS_FRMEVL|BAS_FRMNUM|BAS_GETADR|BAS_GETBYT|BAS_LINPRT|BAS_PTRGET|CFG_IDXA_ADDR_H|CFG_IDXA_ADDR_L|CFG_IDXA_ADDR_M|CFG_IDXA_DEF_H|CFG_IDXA_DEF_L|CFG_IDXA_DEF_M|CFG_IDXA_FLAGS|CFG_IDXA_LIM_H|CFG_IDXA_LIM_L|CFG_IDXA_LIM_M|CFG_IDXA_STP_H|CFG_IDXA_STP_L|CFG_IDXB_ADDR_H|CFG_IDXB_ADDR_L|CFG_IDXB_ADDR_M|CFG_IDXB_DEF_H|CFG_IDXB_DEF_L|CFG_IDXB_DEF_M|CFG_IDXB_FLAGS|CFG_IDXB_LIM_H|CFG_IDXB_LIM_L|CFG_IDXB_LIM_M|CFG_IDXB_STP_H|CFG_IDXB_STP_L|CFG_PORT|CFG_SELECT|CFG_SPEED_H|CFG_SPEED_L|CFG_SPEED_M|CLOCK_60HZ|CLOCK_MS|CLOCK_SNAPSHOT|CLOCK_VERSION|CL_ANIM_DRAWN|CL_ANIM_FILE|CL_ANIM_FLAGS|CL_ANIM_FRAME|CL_ANIM_NUMBER|CL_ANIM_SIZE|CL_ANIM_SPRITE|CL_ANIM_TICKS|CL_ANIM_X|CL_ANIM_Y|CL_BACKGROUND|CL_BANK_LOC|CL_D_ANIMS|CL_D_BPP1|CL_D_DEFAULT|CL_D_ENTRIES|CL_D_HEIGHT|CL_D_HOLES|CL_D_HOLE_TABLE|CL_D_ITEMS|CL_D_LOC|CL_D_LOCS|CL_D_PATH|CL_D_SHAPES|CL_D_SIZE|CL_D_TYPE|CL_D_VOICES|CL_D_WIDTH|CL_D_WIN_COL|CL_D_WIN_COLS|CL_D_WIN_ROW|CL_D_WIN_ROWS|CL_ERR_ARGUMENT|CL_ERR_FILE|CL_ERR_LOCATION|CL_ERR_MISSING|CL_ERR_NOT_LOADED|CL_ERR_RANGE|CL_NOT_LOADED|CL_OVERLAY|CL_PAD_A|CL_PAD_B|CL_PAD_DOWN|CL_PAD_LEFT|CL_PAD_RIGHT|CL_PAD_SELECT|CL_PAD_START|CL_PAD_UP|CL_PALETTES|CL_SONG|CL_SOUND|CL_SPRITES|CL_STATE_SIZE|CL_TICK_FRAME|CL_TICK_WRAP|CL_TILESET|CMD_PARAM1|CMD_PARAM2|CMD_PARAM3|CMD_TRIGGER|ERROR_AUDIO_QUEUE_OVERFLOW|ERROR_CMD_QUEUE_FULL|ERROR_CMD_UNKNOWN|ERROR_CTX_OVERFLOW|ERROR_CTX_UNDERFLOW|ERROR_DMA_QUEUE_FULL|ERROR_DMA_SIZE_ZERO|ERROR_DMA_SRC_WILL_OVERFLOW|ERROR_DMA_TGT_WILL_OVERFLOW|ERROR_FS_CLOSE_FAILED|ERROR_FS_DELETE_FAILED|ERROR_FS_DIR_FAILED|ERROR_FS_FREE_FAILED|ERROR_FS_HANDLE_ALREADY_OPEN|ERROR_FS_INVALID_HANDLE|ERROR_FS_INVALID_REQUEST|ERROR_FS_MKDIR_FAILED|ERROR_FS_MOUNT_FAILED|ERROR_FS_NO_FILE_OPEN|ERROR_FS_OPEN_FAILED|ERROR_FS_READ_FAILED|ERROR_FS_RENAME_FAILED|ERROR_FS_SEEK_FAILED|ERROR_FS_STAT_FAILED|ERROR_FS_SYNC_FAILED|ERROR_FS_WRITE_FAILED|ERROR_H|ERROR_INPUT_MODE_UNAVAILABLE|ERROR_INPUT_PROBE_INVALID|ERROR_INPUT_UDP_ALLOC_FAI