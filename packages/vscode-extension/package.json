{
  "name": "clementina",
  "displayName": "Clementina",
  "description": "Debugging, BASIC and 65C02 assembly language support for the Clementina homebrew computer",
  "version": "0.3.0-alpha.1",
  "repository": {"type": "git", "url": "git+https://github.com/fran150/clementina-sdk.git", "directory": "packages/vscode-extension"},
  "private": true,
  "license": "GPL-3.0-only",
  "publisher": "clementina",
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=20"
  },
  "categories": ["Debuggers", "Programming Languages"],
  "activationEvents": [
    "onDebug",
    "onLanguage:clementina-basic",
    "onCommand:clementina.basic.renumberInteractive",
    "onCommand:clementina.basic.insertGlyph",
    "onCommand:clementina.basic.styleSelection",
    "onCommand:clementina.basic.showScreen",
    "onView:clementina.basic.screen"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "contributes": {
    "languages": [
      {
        "id": "clementina-basic",
        "extensions": [".bas"],
        "aliases": ["Clementina BASIC"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "clementina-asm",
        "extensions": [".s", ".inc"],
        "aliases": ["Clementina Assembly", "65C02 Assembly (ca65)"],
        "configuration": "./asm-language-configuration.json"
      }
    ],
    "grammars": [
      {"language": "clementina-basic", "scopeName": "source.clementina-basic", "path": "./syntaxes/clementina-basic.tmLanguage.json"},
      {"language": "clementina-asm", "scopeName": "source.clementina-asm", "path": "./syntaxes/clementina-asm.tmLanguage.json"}
    ],
    "commands": [
      {"command": "clementina.basic.renumberInteractive", "title": "Clementina BASIC: Renumber Program…"},
      {"command": "clementina.basic.insertGlyph", "title": "Clementina BASIC: Insert Glyph…"},
      {"command": "clementina.basic.styleSelection", "title": "Clementina BASIC: Style Selected Text…"},
      {"command": "clementina.basic.showScreen", "title": "Clementina BASIC: Show Screen Preview"}
    ],
    "breakpoints": [
      {"language": "clementina-basic"},
      {"language": "clementina-asm"}
    ],
    "menus": {
      "commandPalette": [
        {"command": "clementina.basic.insertGlyph", "when": "editorLangId == clementina-basic"},
        {"command": "clementina.basic.styleSelection", "when": "editorLangId == clementina-basic"},
        {"command": "clementina.basic.showScreen", "when": "editorLangId == clementina-basic"}
      ],
      "editor/context": [
        {"command": "clementina.basic.insertGlyph", "when": "editorLangId == clementina-basic", "group": "1_modification@90"},
        {"command": "clementina.basic.styleSelection", "when": "editorLangId == clementina-basic", "group": "1_modification@91"},
        {"command": "clementina.basic.showScreen", "when": "editorLangId == clementina-basic", "group": "1_modification@92"}
      ]
    },
    "viewsContainers": {
      "panel": [
        {"id": "clementina-screen", "title": "Clementina Screen", "icon": "media/screen.svg"}
      ]
    },
    "views": {
      "clementina-screen": [
        {"type": "webview", "id": "clementina.basic.screen", "name": "Clementina Screen"}
      ]
    },
    "debuggers": [
      {
        "type": "clementina",
        "label": "Clementina",
        "languages": ["clementina-basic", "clementina-asm"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Portable project root (containing clementina.yaml)",
                "default": "${workspaceFolder}"
              },
              "emulator": {
                "type": "string",
                "description": "Path to the clementina-automation executable (default: clementina-automation on PATH)"
              },
              "port": {
                "type": "number",
                "description": "Fixed loopback automation port (default: automatic)"
              }
            }
          }
        },
        "initialConfigurations": [
          {"type": "clementina", "request": "launch", "name": "Launch Clementina project", "program": "${workspaceFolder}"}
        ],
        "configurationSnippets": [
          {
            "label": "Clementina: Launch project",
            "body": {"type": "clementina", "request": "launch", "name": "Launch Clementina project", "program": "^\"${1:\\${workspaceFolder\\}}\""}
          }
        ]
      }
    ]
  },
  "devDependencies": {
    "@clementina/basic-lsp": "0.3.0-alpha.1",
    "@clementina/debug-adapter": "0.3.0-alpha.1",
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vscode-languageclient": "^10.1.1"
  },
  "files": ["dist/extension.js", "dist/debug-adapter.mjs", "dist/basic-lsp.mjs", "language-configuration.json", "asm-language-configuration.json", "syntaxes", "media", "LICENSE"]
}
