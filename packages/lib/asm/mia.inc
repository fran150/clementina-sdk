; mia.inc: MIA registers, ids, bits and MIA RAM layout for ca65.
; Generated by clementina-sdk scripts/generate-includes.mjs from specs/*.json. Do not edit:
; change the spec, run npm run generate:includes, and copy the file to the ROM's src/include/.
; Names are MIA's own #defines where MIA has one. Bit values are masks except IDX_FLAG_*,
; which are bit numbers as in MIA. Multi-byte fields name each byte: _L/_M/_H or 0-3.
.ifndef MIA_INC
MIA_INC = 1

; Registers ($FFE0-$FFFF), mia-registers.json
IDXA_PORT                                 = $FFE0     ; Data port for index A.
IDXA_SELECT                               = $FFE1     ; Select index A descriptor.
CFG_SELECT                                = $FFE2     ; Configuration field selector.
CFG_PORT                                  = $FFE3     ; Configuration data port.
IDXB_PORT                                 = $FFE4     ; Data port for index B.
IDXB_SELECT                               = $FFE5     ; Select index B descriptor.
CMD_PARAM1                                = $FFE6     ; Command parameter 1.
CMD_PARAM2                                = $FFE7     ; Command parameter 2.
CMD_PARAM3                                = $FFE8     ; Command parameter 3.
CMD_TRIGGER                               = $FFE9     ; Writing a command id triggers/queues it.
STATUS_L                                  = $FFEA     ; MIA status low.
STATUS_H                                  = $FFEB     ; MIA status high.
ERROR_L                                   = $FFEC     ; Read-to-pop error queue.
ERROR_H                                   = $FFED     ; Error high byte.
IRQ_MASK_L                                = $FFEE     ; IRQ mask low.
IRQ_MASK_H                                = $FFEF     ; IRQ mask high.
IRQ_STATUS_L                              = $FFF0     ; Read clears top-level IRQ status.
IRQ_STATUS_H                              = $FFF1     ; Read before low when high bits matter.
INPUT_STATUS                              = $FFF2     ; Input status.
INPUT_CHAR                                = $FFF3     ; Text FIFO read/pop.
INPUT_CHAR_COUNT                          = $FFF4     ; Text FIFO count.
MIA_CTX                                   = $FFF5     ; Context stack for interrupt handlers, four deep.
NMI_VEC_L                                 = $FFFA     ; NMI vector low.
NMI_VEC_H                                 = $FFFB     ; NMI vector high.
RESET_VEC_L                               = $FFFC     ; RESET vector low.
RESET_VEC_H                               = $FFFD     ; RESET vector high.
IRQ_VEC_L                                 = $FFFE     ; IRQ/BRK vector low.
IRQ_VEC_H                                 = $FFFF     ; IRQ/BRK vector high.
NMI_VEC                                   = $FFFA     ; 16-bit vector
RESET_VEC                                 = $FFFC     ; 16-bit vector
IRQ_VEC                                   = $FFFE     ; 16-bit vector
MIA_CTX_PUSH                              = $01       ; MIA_CTX: Save the context.
MIA_CTX_POP                               = $02       ; MIA_CTX: Restore the last saved context.
INPUT_TEXT_READY                          = %00000001 ; INPUT_STATUS bit 0: The text FIFO contains at least one byte.
INPUT_KEYBOARD_DOWN                       = %00000010 ; INPUT_STATUS bit 1: At least one represented Keyboard/Keypad usage is held.
INPUT_CONSUMER_DOWN                       = %00000100 ; INPUT_STATUS bit 2: At least one represented Consumer usage is held.
INPUT_MOUSE_DOWN                          = %00001000 ; INPUT_STATUS bit 3: At least one mouse button is held.
INPUT_GAMEPAD_DOWN                        = %00010000 ; INPUT_STATUS bit 4: At least one gamepad digital control is held.
INPUT_SOURCE_CONSOLE                      = %00100000 ; INPUT_STATUS bit 5: The console input source owns input.
INPUT_SOURCE_WIFI                         = %01000000 ; INPUT_STATUS bit 6: The Wi-Fi input source owns input.
INPUT_SOURCE_USB_HOST                     = %10000000 ; INPUT_STATUS bit 7: Reserved for a later board's USB keyboard; reads as zero.

; Status bits (STATUS_L, STATUS_H as one 16-bit value), mia-status.json
MIA_STAT_MASTER_MODE                      = $01       ; bit 0: 0 = loader mode, 1 = normal mode.
MIA_STAT_ERRORS                           = $02       ; bit 1: Error queue contains at least one error.
MIA_STAT_CMD_RUNNING                      = $04       ; bit 2: Command handler is executing queued commands.
MIA_STAT_DMA_RUNNING                      = $08       ; bit 3: MIA RAM DMA copy is in progress.
MIA_STAT_SPEED_CHANGING                   = $10       ; bit 4: A PHI2 speed change has been requested and not yet applied.
MIA_STAT_VIDEO_FRAME_REQUESTED            = $20       ; bit 5: Video client update request accepted; ACK not received yet.
MIA_STAT_VIDEO_FRAME_SENT                 = $40       ; bit 6: Initial video response send finished; ACK may still be pending.
MIA_STAT_EXEC_PAUSED                      = $80       ; bit 7: PHI2 is stopped by the exec pause control.
MIA_STAT_AUDIO_ACTIVE                     = $0100     ; bit 8: PWM audio IRQ is running.
MIA_STAT_SD_PRESENT                       = $0200     ; bit 9: SD card initialized successfully.
MIA_STAT_SD_BUSY                          = $0400     ; bit 10: SD/FS command is in progress.
MIA_STAT_FS_MOUNTED                       = $0800     ; bit 11: FAT filesystem is mounted.

; IRQ bits (IRQ_STATUS_L/H, IRQ_MASK_L/H as 16-bit values), mia-irq.json
IRQ_ERROR                                 = $01       ; bit 0: An error was pushed into the error queue.
IRQ_IDXA_WRAPPED                          = $02       ; bit 1: The active index in window A wrapped and its WRAP_IRQ flag was enabled.
IRQ_IDXB_WRAPPED                          = $04       ; bit 2: The active index in window B wrapped and its WRAP_IRQ flag was enabled.
IRQ_COMMAND                               = $08       ; bit 3: Command handler completed; asynchronous commands may raise it again on actual completion.
IRQ_SPEED_CHANGED                         = $10       ; bit 4: A requested PHI2 speed change was applied.
IRQ_VIDEO_FRAME_REQUEST                   = $20       ; bit 5: Video client update request accepted.
IRQ_VIDEO_FRAME_SENT                      = $40       ; bit 6: Initial video response send completed.
IRQ_VIDEO_FRAME_ACKED                     = $80       ; bit 7: Video client acknowledged the response.
IRQ_INPUT_KEYBOARD                        = $0100     ; bit 8: Enabled keyboard, consumer, or text input event pending.
IRQ_INPUT_MOUSE                           = $0200     ; bit 9: Enabled mouse input event pending.
IRQ_INPUT_GAMEPAD                         = $0400     ; bit 10: Enabled gamepad input event pending.
IRQ_SD_DONE                               = $0800     ; bit 11: An SD/FS command completed successfully.
IRQ_SD_ERROR                              = $1000     ; bit 12: An SD/FS command failed.
IRQ_FS_EVENT                              = $2000     ; bit 13: A filesystem command completed.
IRQ_AUDIO_SEQ_DONE                        = $4000     ; bit 14: A sequenced voice's track finished: it reached END, an unrecognized opcode, or its decode/catch-up budget.
IRQ_TRIGGERED                             = $8000     ; bit 15: Aggregate state maintained by MIA when any masked IRQ flag is pending.

; Error codes (ERROR_L), mia-errors.json
ERROR_MIA_CANNOT_ALLOCATE_RAM             = $01       ; Reserved/startup RAM allocation failure code.
ERROR_QUEUE_OVERFLOW                      = $02       ; Error queue overwrote one or more unread errors.
ERROR_DMA_SIZE_ZERO                       = $10       ; DMA copy requested with a byte count of zero.
ERROR_DMA_SRC_WILL_OVERFLOW               = $11       ; DMA source range would exceed the 256 KiB MIA RAM region.
ERROR_DMA_TGT_WILL_OVERFLOW               = $12       ; DMA destination range would exceed the 256 KiB MIA RAM region.
ERROR_DMA_QUEUE_FULL                      = $13       ; A copy could not wait behind the running one: eight were already waiting.
ERROR_CMD_QUEUE_FULL                      = $20       ; Command trigger could not be queued for core 0.
ERROR_CMD_UNKNOWN                         = $21       ; Unknown command id.
ERROR_CTX_OVERFLOW                        = $22       ; MIA_CTX push with the context stack already four deep.
ERROR_CTX_UNDERFLOW                       = $23       ; MIA_CTX pop with nothing saved.
ERROR_WIFI_INIT_FAILED                    = $30       ; CYW43/Wi-Fi chip initialization failed.
ERROR_WIFI_CONNECT_FAILED                 = $31       ; STA connection failed.
ERROR_VIDEO_UDP_ALLOC_FAILED              = $40       ; Video UDP PCB allocation failed.
ERROR_VIDEO_UDP_BIND_FAILED               = $41       ; Video UDP bind failed.
ERROR_INPUT_MODE_UNAVAILABLE              = $50       ; Requested input mode is unknown, reserved (2), or not available right now (Wi-Fi without its listener).
ERROR_INPUT_PROBE_INVALID                 = $51       ; Requested input probe id is invalid.
ERROR_INPUT_UDP_ALLOC_FAILED              = $52       ; Input UDP PCB allocation failed.
ERROR_INPUT_UDP_BIND_FAILED               = $53       ; Input UDP bind failed.
ERROR_AUDIO_QUEUE_OVERFLOW                = $60       ; Live audio register writes outran the audio IRQ queue; the IRQ resynchronized from RAM.
ERROR_SD_BUSY                             = $70       ; A new SD/FS request was made while another request was running.
ERROR_SD_INIT_FAILED                      = $71       ; SD card initialization failed.
ERROR_SD_NOT_READY                        = $72       ; Raw SD command requested before initialization.
ERROR_SD_READ_FAILED                      = $73       ; Raw SD sector read failed.
ERROR_SD_WRITE_FAILED                     = $74       ; Raw SD sector write failed.
ERROR_FS_MOUNT_FAILED                     = $78       ; FAT filesystem mount failed.
ERROR_FS_OPEN_FAILED                      = $79       ; FAT file open failed.
ERROR_FS_READ_FAILED                      = $7A       ; FAT file read or load failed.
ERROR_FS_CLOSE_FAILED                     = $7B       ; FAT file close failed.
ERROR_FS_DIR_FAILED                       = $7C       ; FAT directory operation failed.
ERROR_FS_INVALID_REQUEST                  = $7D       ; SD/FS request parameters are invalid.
ERROR_FS_NO_FILE_OPEN                     = $7E       ; File I/O was requested with no open file.
ERROR_FS_WRITE_FAILED                     = $7F       ; FAT file write failed.
ERROR_FS_SEEK_FAILED                      = $80       ; FAT file seek failed.
ERROR_FS_SYNC_FAILED                      = $81       ; FAT file sync failed.
ERROR_FS_STAT_FAILED                      = $82       ; FAT stat failed.
ERROR_FS_MKDIR_FAILED                     = $83       ; FAT mkdir failed.
ERROR_FS_DELETE_FAILED                    = $84       ; FAT delete failed.
ERROR_FS_RENAME_FAILED                    = $85       ; FAT rename failed.
ERROR_FS_FREE_FAILED                      = $86       ; FAT free-space query failed.
ERROR_FS_HANDLE_ALREADY_OPEN              = $87       ; FS_OPEN requested on a handle slot that is already open.
ERROR_FS_INVALID_HANDLE                   = $88       ; SD_HANDLE_SELECT names a slot outside the supported range.

