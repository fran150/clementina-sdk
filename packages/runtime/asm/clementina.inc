; clementina.inc: everything a Clementina assembly program can rely on, for ca65.
; Generated by clementina-sdk scripts/generate-includes.mjs from specs/*.json. Do not edit.
; Call the kernel only through the jump table; other kernel addresses move between builds.
.ifndef CLEMENTINA_INC
CLEMENTINA_INC = 1

.include "mia.inc"

; Kernel jump table, kernel-abi.json: JSR these; they never move
KERN_COLDSTART    = $0400
KERN_WARMSTART    = $0403
KERN_CHROUT       = $0406
KERN_CHRIN        = $0409
KERN_GETKEY_NB    = $040C
KERN_CLRSCR       = $040F
KERN_PRHEX        = $0412
KERN_PRBYTE       = $0415
KERN_PRSTR        = $0418
KERN_LOAD         = $041B
KERN_EDITKEY      = $041E
KERN_CHROUT_GLYPH = $0421
KERN_WOZMON       = $0424
KERN_SET_BACKDROP = $0427
KERN_IRQ          = $042A
KERN_PLOT         = $042D
KERN_RDTIM        = $0430
KERN_SETTIM       = $0433

; Zero page free for programs, cpu-memory-map.json
ZP_FREE_START     = $98
ZP_FREE_END       = $DF       ; last free byte

; Clock snapshot that KERN_RDTIM writes, cpu-memory-map.json
CLOCK_SNAPSHOT    = $02F8
CLOCK_MS          = $02F8     ; 4 bytes
CLOCK_60HZ        = $02FC     ; 3 bytes
CLOCK_VERSION     = $02FF     ; 1 byte

; 65C22 VIA, cpu-memory-map.json
VIA_BASE          = $C000     ; registers repeat every 16 bytes
VIA_ORB           = $C000     ; Port B data.
VIA_ORA           = $C001     ; Port A data.
VIA_DDRB          = $C002     ; Port B direction.
VIA_DDRA          = $C003     ; Port A direction.
VIA_T1CL          = $C004     ; Timer 1 counter low.
VIA_T1CH          = $C005     ; Timer 1 counter high.
VIA_T1LL          = $C006     ; Timer 1 latch low.
VIA_T1LH          = $C007     ; Timer 1 latch high.
VIA_T2CL          = $C008     ; Timer 2 counter low.
VIA_T2CH          = $C009     ; Timer 2 counter high.
VIA_SR            = $C00A     ; Shift register.
VIA_ACR           = $C00B     ; Auxiliary control.
VIA_PCR           = $C00C     ; Peripheral control (CA1/CA2, CB1/CB2).
VIA_IFR           = $C00D     ; Interrupt flags.
VIA_IER           = $C00E     ; Interrupt enable.
VIA_ORA_NH        = $C00F     ; Port A data without handshake.

.endif
